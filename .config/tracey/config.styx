specs (
    {
        name kuria
        include (
            docs/spec/**/*.md
        )
        impls (
            {
                name rust
                include (
                    items/**/*.rs
                )
                exclude (
                    target/**
                )
            }
            {
                name web
                include (
                    items/web/src/**/*.ts
                    items/web/src/**/*.svelte
                    e2e/**/*.ts
                )
                exclude (
                    **/node_modules/**
                    items/web/src/lib/graphql/generated/**
                )
            }
        )
    }
)
