{
  "archive": {
    "rules": [
      {
        "with_container": "plan"
      }
    ]
  },
  "created_in": [
    "plan"
  ],
  "fields": [
    {
      "key": "title",
      "kind": "text",
      "name": "Title",
      "required": true
    },
    {
      "key": "description",
      "kind": "text",
      "multiline": true,
      "name": "Description"
    },
    {
      "description": "What must be true for it to be done.",
      "key": "acceptance",
      "kind": "text",
      "multiline": true,
      "name": "Acceptance"
    },
    {
      "key": "assignee",
      "kind": "user",
      "name": "Assignee"
    },
    {
      "description": "The pull request or commit that does it.",
      "key": "change",
      "kind": "reference",
      "name": "Change"
    }
  ],
  "key": "task",
  "links": [
    {
      "inverse": "Blocked by",
      "key": "blocks",
      "name": "Blocks",
      "to": [
        "task"
      ]
    }
  ],
  "name": "Task",
  "number": "{parent}-T{seq:2}",
  "presentation": {
    "card": [
      "assignee"
    ],
    "colour": "teal",
    "icon": "list-checks",
    "list": [
      "assignee"
    ],
    "tones": {
      "doing": "active",
      "done": "success",
      "dropped": "neutral",
      "review": "warning"
    }
  },
  "states": [
    {
      "initial": true,
      "key": "todo",
      "name": "To do"
    },
    {
      "key": "doing",
      "name": "Doing"
    },
    {
      "key": "review",
      "name": "In review"
    },
    {
      "final": true,
      "key": "done",
      "name": "Done"
    },
    {
      "final": true,
      "key": "dropped",
      "name": "Dropped"
    }
  ],
  "transitions": [
    {
      "from": [
        "todo"
      ],
      "key": "start",
      "name": "Start",
      "to": "doing"
    },
    {
      "from": [
        "doing"
      ],
      "key": "review",
      "name": "Send to review",
      "to": "review"
    },
    {
      "from": [
        "review"
      ],
      "key": "rework",
      "name": "Rework",
      "to": "doing"
    },
    {
      "from": [
        "doing",
        "review"
      ],
      "key": "finish",
      "name": "Finish",
      "to": "done"
    },
    {
      "from": [
        "todo",
        "doing",
        "review"
      ],
      "key": "drop",
      "name": "Drop",
      "to": "dropped"
    }
  ]
}
