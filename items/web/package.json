{
	"name": "kuria-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run codegen && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run codegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run codegen && vitest --run",
		"codegen": "graphql-codegen --config codegen.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@graphql-codegen/cli": "^8.0.0",
		"@graphql-codegen/client-preset": "^7.0.0",
		"@graphql-codegen/introspection": "^7.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^31.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"@lexical/code": "0.53.0",
		"@lexical/headless": "0.53.0",
		"@lexical/history": "0.53.0",
		"@lexical/link": "0.53.0",
		"@lexical/list": "0.53.0",
		"@lexical/markdown": "0.53.0",
		"@lexical/rich-text": "0.53.0",
		"@lexical/selection": "0.53.0",
		"@lexical/table": "0.53.0",
		"@lexical/utils": "0.53.0",
		"@lucide/svelte": "^1.72.0",
		"@urql/core": "^6.0.3",
		"@urql/exchange-graphcache": "^9.0.2",
		"bits-ui": "^2.21.0",
		"dompurify": "^3.4.17",
		"graphql": "^17.1.0",
		"graphql-ws": "^6.4.2",
		"lexical": "0.53.0",
		"lib0": "0.2.119",
		"marked": "^18.2.0",
		"y-protocols": "1.0.7",
		"y-websocket": "3.1.0",
		"yjs": "13.6.33"
	}
}
