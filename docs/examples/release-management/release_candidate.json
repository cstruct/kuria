{
  "key": "release_candidate",
  "name": "Release candidate",
  "number": "{parent}-RC-{seq:4}",
  "created_in": ["release"],
  "fields": [
    { "key": "build", "name": "Build", "kind": "reference" },
    { "key": "test_record", "name": "Test record", "kind": "reference" }
  ],
  "states": [
    { "key": "testing", "name": "Testing", "initial": true },
    { "key": "accepted", "name": "Accepted", "final": true },
    { "key": "rejected", "name": "Rejected", "final": true }
  ],
  "transitions": [
    { "key": "accept", "name": "Accept", "from": ["testing"], "to": "accepted",
      "requires": ["build", "test_record"] },
    { "key": "reject", "name": "Reject", "from": ["testing"], "to": "rejected" }
  ],
  "contains": [{ "type": "epic" }, { "type": "backlog_item" }, { "type": "artifact" }],
  "board": { "columns": [
    { "key": "todo", "name": "To do",
      "states": { "backlog_item": ["open"], "epic": ["open"] } },
    { "key": "doing", "name": "In progress",
      "states": { "backlog_item": ["in_progress", "in_review"], "epic": ["in_progress"] } },
    { "key": "done", "name": "Done",
      "states": { "backlog_item": ["done"], "epic": ["done"] } }
  ] }
}
