{
  "key": "hotfix",
  "name": "Hotfix",
  "number": "{parent}-HOTFIX-{seq:4}",
  "created_in": ["release"],
  "fields": [
    { "key": "reason", "name": "Why it can't wait", "kind": "text", "multiline": true, "required": true },
    { "key": "build", "name": "Build", "kind": "reference" }
  ],
  "states": [
    { "key": "open", "name": "Open", "initial": true },
    { "key": "deployed", "name": "Deployed", "final": true }
  ],
  "transitions": [
    { "key": "deploy", "name": "Deploy", "from": ["open"], "to": "deployed",
      "requires": ["build"], "action": "release:approve" }
  ],
  "contains": [{ "type": "backlog_item" }, { "type": "artifact" }],
  "archive": { "rules": [{ "with_container": "release" }] },
  "presentation": {
    "group": "Releasing", "icon": "wrench", "colour": "red", "card": ["build"], "list": ["build"], "tones": { "open": "warning", "deployed": "success" } }
}
