{
  "key": "backlog_item",
  "name": "Backlog item",
  "number": "ITEM-{seq:4}",
  "fields": [
    { "key": "title", "name": "Title", "kind": "text", "required": true },
    { "key": "kind", "name": "Kind", "kind": "choice",
      "options": [
        { "key": "feature", "name": "Feature" },
        { "key": "fix", "name": "Fix" },
        { "key": "chore", "name": "Chore" }
      ] },
    { "key": "description", "name": "Description", "kind": "text", "multiline": true },
    { "key": "assignee", "name": "Assignee", "kind": "user" },
    { "key": "change", "name": "Pull request", "kind": "reference" }
  ],
  "states": [
    { "key": "open", "name": "Open", "initial": true },
    { "key": "in_progress", "name": "In progress" },
    { "key": "in_review", "name": "In review" },
    { "key": "done", "name": "Done", "final": true }
  ],
  "transitions": [
    { "key": "start", "name": "Start", "from": ["open"], "to": "in_progress" },
    { "key": "review", "name": "Send to review", "from": ["in_progress"], "to": "in_review",
      "requires": ["change"] },
    { "key": "rework", "name": "Rework", "from": ["in_review"], "to": "in_progress" },
    { "key": "finish", "name": "Finish", "from": ["in_review"], "to": "done" }
  ],
  "archive": { "rules": [{ "days_in": 90, "in": ["done"] }] },
  "presentation": {
    "icon": "file-text", "colour": "neutral",
    "card": ["kind", "assignee"], "list": ["kind", "assignee"],
    "tones": { "in_progress": "active", "in_review": "warning", "done": "success" }
  }
}
