{
  "key": "release_notes",
  "name": "Release notes",
  "number": "{parent}-NOTES-{seq}",
  "created_in": ["release"],
  "fields": [
    { "key": "text", "name": "Text", "kind": "text", "multiline": true,
      "draft": {
        "through": ["release_candidate", "hotfix", "epic"],
        "depth": 3,
        "types": ["epic", "backlog_item"],
        "line": "- {number} {field:title} ({field:kind})",
        "group_by": "type",
        "states": { "release_candidate": ["accepted"], "hotfix": ["deployed"] }
      } },
    { "key": "artifacts", "name": "Artifacts", "kind": "text", "multiline": true,
      "draft": {
        "through": ["release_candidate", "hotfix"],
        "depth": 2,
        "types": ["artifact"],
        "line": "- {field:component} {field:version}: {field:image}",
        "latest_by": "component",
        "exclude": { "change": ["removed"] }
      } }
  ],
  "states": [
    { "key": "draft", "name": "Draft", "initial": true },
    { "key": "approved", "name": "Approved", "final": true }
  ],
  "transitions": [
    { "key": "approve", "name": "Approve", "from": ["draft"], "to": "approved",
      "requires": ["text"], "action": "release:approve" }
  ],
  "archive": { "rules": [{ "with_container": "release" }] },
  "presentation": { "icon": "notebook-pen", "colour": "pink", "navigation": "more", "plural": "Release notes", "tones": { "draft": "warning", "approved": "success" } }
}
